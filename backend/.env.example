# Server Configuration
PORT=5000
NODE_ENV=production
BACKEND_PUBLIC_URL=https://api.srads.com

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=srads_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Cashfree Configuration
CASHFREE_ENV=production
CASHFREE_CLIENT_ID=your_cashfree_production_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_production_secret_key
CASHFREE_API_VERSION=2025-01-01
